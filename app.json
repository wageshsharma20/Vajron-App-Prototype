{
  "expo": {
    "name": "DDA AI Park Monitor",
    "slug": "AppPrototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vajron.prototype"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload verification images.",
          "cameraPermission": "The app needs access to your camera to take verification photos."
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "cb6363a1-0787-4dfe-8c90-fabebc5c3f55"
      }
    }
  }
}
