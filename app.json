{
  "expo": {
    "name": "DDA AI Park Monitor",
    "slug": "AppPrototype",
    "owner": "wageshsharmas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vajron.prototype",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload verification images.",
          "cameraPermission": "The app needs access to your camera to take verification photos."
        }
      ],
      "expo-video",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "3a0fcc6b-4f6a-4eca-b4a7-1d0d2213d1a9"
      }
    }
  }
}
